{
  "name": "trustid-caliper-benchmark",
  "version": "1.0.0",
  "description": "Bộ benchmark chaincode TrustID bằng Hyperledger Caliper",
  "private": true,
  "scripts": {
    "bind": "caliper bind --caliper-bind-sut fabric:2.4",
    "bench": "caliper launch manager --caliper-workspace ./ --caliper-networkconfig networkConfig.yaml --caliper-benchconfig benchmarkConfig.yaml --caliper-flow-only-test --caliper-report-path ../ket_qua/caliper_report.html"
  },
  "dependencies": {
    "@hyperledger/caliper-cli": "0.6.0"
  }
}
